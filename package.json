{
  "name": "mooogor-start",
  "description": "A fast, offline-first new tab launcher with common sites, multi-engine search, bookmarks, and history.",
  "private": true,
  "version": "1.6.5",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "postinstall": "wxt prepare"
  },
  "devDependencies": {
    "@tsconfig/svelte": "^5.0.6",
    "@types/validator": "^13.15.10",
    "@wxt-dev/module-svelte": "^2.0.4",
    "svelte": "^5.46.0",
    "svelte-check": "^4.3.4",
    "svelte-dnd-action": "^0.9.69",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "wxt": "^0.20.6"
  },
  "dependencies": {
    "@lucide/svelte": "^0.563.1",
    "dexie": "^4.2.1",
    "validator": "^13.15.26",
    "webext-bridge": "^6.0.1"
  }
}
