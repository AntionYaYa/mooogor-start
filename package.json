{
  "name": "mooogor-start",
  "description": "A fast, offline-first new tab launcher with common sites, multi-engine search, bookmarks, and history.",
  "private": true,
  "version": "1.7.8",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "pnpm licenses:generate && wxt build",
    "build:firefox": "pnpm licenses:generate && wxt build -b firefox",
    "zip": "pnpm licenses:generate && wxt zip",
    "zip:firefox": "pnpm licenses:generate && wxt zip -b firefox",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "colors:defaults": "node scripts/extract-default-site-colors.mjs --write",
    "postinstall": "wxt prepare",
    "licenses:generate": "node scripts/generate-third-party-notices.mjs"
  },
  "devDependencies": {
    "@tsconfig/svelte": "^5.0.6",
    "@types/validator": "^13.15.10",
    "@wxt-dev/module-svelte": "^2.0.4",
    "svelte": "^5.46.0",
    "svelte-check": "^4.3.4",
    "svelte-dnd-action": "^0.9.69",
    "tslib": "^2.8.1",
    "typescript": "^5.9.3",
    "wxt": "^0.20.6"
  },
  "dependencies": {
    "@lucide/svelte": "^0.563.1",
    "colorthief": "3.5.0",
    "dexie": "^4.2.1",
    "qr-code-styling": "1.9.2",
    "validator": "^13.15.26",
    "webext-bridge": "^6.0.1"
  },
  "homepage": "https://gitee.com/antion666/mooogor_new_tab",
  "repository": {
    "type": "git",
    "url": "https://gitee.com/antion666/mooogor_new_tab.git"
  },
  "bugs": {
    "url": "https://gitee.com/antion666/mooogor_new_tab/issues"
  },
  "author": "Antion",
  "license": "MIT"
}
